# Salin file ini menjadi .env, lalu isi nilainya.
#   cp env.example .env
# JANGAN commit file .env ke Git (tambahkan ke .gitignore).
# Jika nilai mengandung spasi atau karakter khusus ($ ! # &), apit dengan tanda kutip tunggal.

DB_NAME=webapp_db
DB_USER=webapp_user
# Wajib diisi sebelum deploy. Dikosongkan sengaja agar tidak ada password di repositori.
DB_PASS=

APP_PORT=8000
DOMAIN_NAME=_
